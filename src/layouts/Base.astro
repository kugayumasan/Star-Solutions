---
// Paginaskelet: meta-tags, header, mobiel menu, footer en het script voor de hele site.
import '../styles/main.css';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Footer from '../components/layout/Footer.astro';
import CallFab from '../components/layout/CallFab.astro';
import siteScript from '../scripts/site.js?raw';
import { company } from '../data/site';
import { asset } from '../lib';

interface Props { title: string; description?: string; current?: string; }
const { title, description = `${company.name} uit Gent: bouw & renovatie, schoonmaak, industriële reiniging, groenonderhoud, logistiek en desinfectie. ${company.availability}.`, current = '' } = Astro.props;
const fullTitle = current === '' ? `${company.name} | ${company.tagline}` : `${title} | ${company.name}`;
---
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="claude:viewport-fit-sides" content="cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`https://starsolutions-service.be/${company.heroImage.src}`} />
    <meta name="theme-color" content="#0c1724" />
    <link rel="icon" href={asset(company.favicon)} sizes="32x32" />
    <link rel="apple-touch-icon" href={asset(company.logo)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..900&family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Header current={current} />
    <MobileMenu />

    <main>
      <slot />
    </main>

    <Footer />
    <CallFab />

    <script is:inline set:html={siteScript} />
  </body>
</html>
